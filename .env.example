PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:4000
JWT_SECRET=replace-with-a-32-character-minimum-production-secret
REFRESH_TOKEN_SECRET=replace-with-a-separate-32-character-refresh-secret
VERIFICATION_PEPPER=replace-with-a-rotated-secret-pepper
DATABASE_URL=postgresql://safeshare:password@localhost:5432/safeshare
REDIS_URL=redis://127.0.0.1:6379

# Matching versions: standard, dorm, nearby.
# The UI stores the selected version in the profile JSONB metadata.
NEARBY_MATCH_RADIUS_KM=1

# Mock mode is deliberately the default. Set false only after PostgreSQL repositories
# and external vendor adapters are configured for the deployment environment.
MOCK_MODE=false
MOCK_TENANT_COUNT=300
LIVE_DEMO_TARGET=30
LIVE_DEMO_REDIS_REQUIRED=true
ENABLE_CRON=false
PERSISTENCE_READY=false
OPENAI_API_KEY=
AGREEMENT_MODEL=gpt-4o-mini
AGREEMENT_PROVIDER=openai
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Agreement generation capacity. Requests are queued instead of sending 30
# Gemini calls at the same time. Tune these in the deployment environment.
AGREEMENT_MAX_CONCURRENCY=4
AGREEMENT_QUEUE_MAX=60
AGREEMENT_QUEUE_WAIT_TIMEOUT_MS=180000
AGREEMENT_PROVIDER_TIMEOUT_MS=20000
AGREEMENT_RETRY_COUNT=2
AGREEMENT_PROVIDER_RPM=15
AGREEMENT_MAX_OUTPUT_TOKENS=6000
AGREEMENT_CACHE_TTL_SECONDS=1800

# HTTP connection protection for the API server.
HTTP_REQUEST_TIMEOUT_MS=240000
HTTP_HEADERS_TIMEOUT_MS=15000
HTTP_KEEPALIVE_TIMEOUT_MS=65000

# ESP32 30일 케어 시연. 로컬 PC에서만 true로 켜세요.
ESP32_RECEIVER_ENABLED=false
ESP32_PYTHON=python
ESP32_PORT=COM4
ESP32_RECEIVER_PATH=esp32/sharehouse_receiver.py
ESP32_RESULTS_PATH=esp32/sharehouse_results.json
