PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:4000
JWT_SECRET=replace-with-a-32-character-minimum-production-secret
REFRESH_TOKEN_SECRET=replace-with-a-separate-32-character-refresh-secret
VERIFICATION_PEPPER=replace-with-a-rotated-secret-pepper
DATABASE_URL=postgresql://safeshare:password@localhost:5432/safeshare
REDIS_URL=redis://127.0.0.1:6379

# Mock mode is deliberately the default. Set false only after PostgreSQL repositories
# and external vendor adapters are configured for the deployment environment.
MOCK_MODE=true
MOCK_TENANT_COUNT=300
ENABLE_CRON=false
PERSISTENCE_READY=false
OPENAI_API_KEY=
AGREEMENT_MODEL=gpt-4o-mini
AGREEMENT_PROVIDER=openai
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
