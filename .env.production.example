NODE_ENV=production
MOCK_MODE=false
# Keep false until every domain API has been migrated from server/store.js.
PERSISTENCE_READY=false
ENABLE_CRON=false
PORT=4000
CLIENT_ORIGIN=https://checkmate.vercel.app
# Set this to the Neon connection string. Keep sslmode=require.
# For the MVP, the same Neon URL can be used for Prisma and the API runtime.
DATABASE_URL=postgresql://user:password@ep-example.ap-southeast-1.aws.neon.tech/checkmate?sslmode=require
# Set this to the public URL of the separately hosted Node.js API.
VITE_API_URL=https://your-backend-host.example.com
REDIS_URL=redis://...
JWT_SECRET=generate-a-long-random-secret
REFRESH_TOKEN_SECRET=generate-another-long-random-secret
VERIFICATION_PEPPER=generate-a-separate-rotated-secret
SENTRY_DSN=https://...
OPENAI_API_KEY=
AGREEMENT_MODEL=gpt-4o-mini
AGREEMENT_PROVIDER=openai
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
